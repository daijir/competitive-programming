{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C++ GDB デバッグ (input.txt から自動入力)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "args": [
        "<",
        "${workspaceFolder}/c++/input.txt"
      ],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "setupCommands": [
        {
          "description": "gdb の再フォーマットを有効化",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "C/C++: g++.exe デバッグ用ビルド"
    }
  ]
}
